# name: test/sql/local/catalog_test_config_setup/catalog_agnostic/functions/test_iceberg_truncate.test
# description: Test iceberg_truncate scalar function against Iceberg spec
# group: [functions]

# Spec: https://iceberg.apache.org/spec/#truncate-transform-details

require avro

require parquet

require iceberg

require httpfs

# Do not ignore 'HTTP' error messages!
set ignore_error_messages

# ---- NULL handling ----
# Iceberg spec: all transforms return null for null input

query I
SELECT iceberg_truncate(10, NULL::INTEGER);
----
NULL

query I
SELECT iceberg_truncate(10, NULL::BIGINT);
----
NULL

query I
SELECT iceberg_truncate(5, NULL::VARCHAR);
----
NULL

query I
SELECT iceberg_truncate(5, NULL::BLOB);
----
NULL

# ---- Return types ----

query I
SELECT typeof(iceberg_truncate(10, 1::INTEGER));
----
INTEGER

query I
SELECT typeof(iceberg_truncate(10, 1::BIGINT));
----
BIGINT

query I
SELECT typeof(iceberg_truncate(3, 'hello'));
----
VARCHAR

query I
SELECT typeof(iceberg_truncate(2, '\x01\x02\x03'::BLOB));
----
BLOB

# ---- INTEGER: v - (((v % W) + W) % W) ----
# truncate[10](0) = 0
query I
SELECT iceberg_truncate(10, 0::INTEGER);
----
0

# truncate[10](1) = 0
query I
SELECT iceberg_truncate(10, 1::INTEGER);
----
0

# truncate[10](9) = 0
query I
SELECT iceberg_truncate(10, 9::INTEGER);
----
0

# truncate[10](10) = 10
query I
SELECT iceberg_truncate(10, 10::INTEGER);
----
10

# truncate[10](11) = 10
query I
SELECT iceberg_truncate(10, 11::INTEGER);
----
10

# truncate[10](-1) = -10  (floor toward negative infinity)
query I
SELECT iceberg_truncate(10, -1::INTEGER);
----
-10

# truncate[10](-10) = -10
query I
SELECT iceberg_truncate(10, -10::INTEGER);
----
-10

# truncate[10](-11) = -20
query I
SELECT iceberg_truncate(10, -11::INTEGER);
----
-20

# ---- BIGINT ----

query I
SELECT iceberg_truncate(10, 0::BIGINT);
----
0

query I
SELECT iceberg_truncate(10, 11::BIGINT);
----
10

query I
SELECT iceberg_truncate(10, -1::BIGINT);
----
-10

# ---- VARCHAR: first L grapheme clusters ----
# truncate[3]("iceberg") = "ice"
query I
SELECT iceberg_truncate(3, 'iceberg');
----
ice

# truncate[7]("iceberg") = "iceberg" (width >= length, return as-is)
query I
SELECT iceberg_truncate(7, 'iceberg');
----
iceberg

# truncate[10]("iceberg") = "iceberg" (width > length)
query I
SELECT iceberg_truncate(10, 'iceberg');
----
iceberg

# Empty string stays empty
query I
SELECT iceberg_truncate(5, '');
----
(empty)

# ---- BLOB: first L bytes ----

query I
SELECT iceberg_truncate(2, '\x01\x02\x03\x04'::BLOB);
----
\x01\x02

# Width >= length returns the full blob
query I
SELECT iceberg_truncate(10, '\x01\x02'::BLOB);
----
\x01\x02

# ---- Result is always a multiple of W for integers ----

query I
SELECT bool_and(iceberg_truncate(10, range::INTEGER) % 10 = 0)
FROM range(-100, 100);
----
true

query I
SELECT bool_and(iceberg_truncate(7, range::INTEGER) % 7 = 0)
FROM range(-100, 100);
----
true

# ---- Result is <= input for non-negative integers ----

query I
SELECT bool_and(iceberg_truncate(10, range::INTEGER) <= range)
FROM range(0, 100);
----
true

# ---- Width = 0 is invalid (Iceberg spec requires positive width) ----
# A constant width is rejected while binding.

statement error
SELECT iceberg_truncate(0, 1::INTEGER);
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

statement error
SELECT iceberg_truncate(0, 1::BIGINT);
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

statement error
SELECT iceberg_truncate(0, 'iceberg');
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

statement error
SELECT iceberg_truncate(0, '\x01\x02'::BLOB);
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

statement error
SELECT iceberg_truncate(-3, 1::INTEGER);
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got -3.*

# ---- Width that is not foldable skips the bind check and must be rejected
# ---- at execution rather than dividing by zero.

statement ok
CREATE TABLE truncate_widths(w INTEGER, v INTEGER);

statement ok
INSERT INTO truncate_widths VALUES (0, 42), (-3, 42), (4, 42);

statement error
SELECT iceberg_truncate(w, v) FROM truncate_widths WHERE w = 0;
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

statement error
SELECT iceberg_truncate(w, v) FROM truncate_widths WHERE w < 0;
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got -3.*

statement error
SELECT iceberg_truncate(w, v::BIGINT) FROM truncate_widths WHERE w = 0;
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

statement error
SELECT iceberg_truncate(w, v::DECIMAL(4,1)) FROM truncate_widths WHERE w = 0;
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

statement error
SELECT iceberg_truncate(w, v::DECIMAL(9,2)) FROM truncate_widths WHERE w = 0;
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

statement error
SELECT iceberg_truncate(w, v::DECIMAL(18,2)) FROM truncate_widths WHERE w = 0;
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

statement error
SELECT iceberg_truncate(w, v::DECIMAL(38,2)) FROM truncate_widths WHERE w = 0;
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

statement error
SELECT iceberg_truncate(w, 'iceberg') FROM truncate_widths WHERE w = 0;
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

statement error
SELECT iceberg_truncate(w, '\x01\x02'::BLOB) FROM truncate_widths WHERE w = 0;
----
<REGEX>:.*iceberg_truncate: width must be a positive integer, got 0.*

# A positive runtime width still works, and the check costs it nothing.

query I
SELECT iceberg_truncate(w, v) FROM truncate_widths WHERE w > 0;
----
40

# Large widths: the intermediate (v % W) + W must not overflow int32.

query I
SELECT iceberg_truncate(1500000000, 1000000000::INTEGER);
----
0

query I
SELECT iceberg_truncate(2000000000, -1::INTEGER);
----
-2000000000
