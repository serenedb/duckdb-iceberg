# name: test/sql/local/catalog_custom_setup/fixture/attach_options/vended_credential_cleanup.test
# description: internal credential secrets are dropped when the transaction ends, so repeated reads do not accumulate them
# note: the local fixture returns no storage-credentials, so this covers the config-secret branch only
# group: [attach_options]

require-env FIXTURE_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

require aws

set ignore_error_messages

statement ok
CREATE SECRET (
    TYPE S3,
    KEY_ID 'admin',
    SECRET 'password',
    ENDPOINT '127.0.0.1:9000',
    URL_STYLE 'path',
    USE_SSL 0,
    REGION 'us-east-1'
);

statement ok
ATTACH '' AS sigv4_lake (
    TYPE ICEBERG,
    ENDPOINT 'http://127.0.0.1:8181',
    AUTHORIZATION_TYPE 'sigv4',
    SIGV4_SERVICE 'custom',
    SIGV4_REGION 'us-east-1'
);

statement ok
create schema if not exists sigv4_lake.default;

statement ok
drop table if exists sigv4_lake.default.test_vended_credential_cleanup;

statement ok
create table sigv4_lake.default.test_vended_credential_cleanup as select 1 as id;

statement ok
select count(*) from sigv4_lake.default.test_vended_credential_cleanup;

query I
select count(*) from duckdb_secrets()
where name like '__internal_ic%test_vended_credential_cleanup%';
----
0

statement ok
select count(*) from sigv4_lake.default.test_vended_credential_cleanup;

statement ok
select count(*) from sigv4_lake.default.test_vended_credential_cleanup;

statement ok
select count(*) from sigv4_lake.default.test_vended_credential_cleanup;

query I
select count(*) from duckdb_secrets()
where name like '__internal_ic%test_vended_credential_cleanup%';
----
0

statement ok
insert into sigv4_lake.default.test_vended_credential_cleanup values (2);

query I
select count(*) from duckdb_secrets()
where name like '__internal_ic%test_vended_credential_cleanup%';
----
0

query I
select count(*) from sigv4_lake.default.test_vended_credential_cleanup;
----
2

statement ok
drop table if exists sigv4_lake.default.test_vended_credential_cleanup;
