# name: test/sql/local/catalog_custom_setup/vended_mock/vended_credentials.test
# description: vended storage credentials are renewed when expired, dropped when the transaction ends, and advertised on commits
# group: [vended_mock]

# Requires: python3 scripts/vended_credential_mock_server.py 19140
require-env VENDED_MOCK_SERVER_AVAILABLE

require avro

require parquet

require iceberg

require httpfs

statement ok
attach 'mock' as vend_mock (
    TYPE ICEBERG,
    ENDPOINT 'http://127.0.0.1:19140',
    AUTHORIZATION_TYPE 'none'
);

statement ok
begin transaction;

statement ok
select count(*) from vend_mock.vend.t;

query I
select count(*) from duckdb_secrets() where name like '__internal_ic%';
----
1

statement ok
select count(*) from vend_mock.vend.t;

query I
select count(*) > 1 from duckdb_secrets() where name like '__internal_ic%';
----
true

query I
select count(*) = count(distinct regexp_extract(name, 'vend-[0-9]+'))
from duckdb_secrets() where name like '__internal_ic%';
----
true

statement ok
commit;

query I
select count(*) from duckdb_secrets() where name like '__internal_ic%';
----
0

statement ok
select count(*) from vend_mock.vend.t;

query I
select count(*) from duckdb_secrets() where name like '__internal_ic%';
----
0

statement ok
alter table vend_mock.vend.t add column extra integer;

statement ok
detach vend_mock;
